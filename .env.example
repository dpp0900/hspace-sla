# Web server
SLA_ENV=production
SLA_WEB_HOST=0.0.0.0
SLA_WEB_PORT=8000
SLA_APP_HOME=/data
SLA_DB_PATH=/data/db/sla_app.db
SLA_BUILD_SHA=
SLA_PROXY_HEADERS=true
SLA_FORWARDED_ALLOW_IPS=127.0.0.1
SLA_ROOT_PATH=
SLA_GRACEFUL_SHUTDOWN_TIMEOUT=30
SLA_CONTAINER_STOP_GRACE_PERIOD=45s
SLA_LOG_LEVEL=INFO
SLA_MIN_FREE_DISK_MB=0
SLA_READY_CHECK_APPIUM=false

# Production readiness requires Basic Auth, CSRF secret, trusted origins, allowed hosts, and build SHA.
# Use a 16+ character auth password and 32+ character CSRF secret; placeholders fail readiness.
# Set both Basic Auth values together in shared or public environments.
SLA_BASIC_AUTH_USER=
SLA_BASIC_AUTH_PASSWORD=
SLA_CSRF_SECRET=
SLA_TRUSTED_ORIGINS=
SLA_ALLOWED_HOSTS=
SLA_RUN_WORKERS=1
SLA_RUN_QUEUE_LIMIT=10
SLA_RECOVER_INCOMPLETE_RUNS=true

# MCP server for LLM clients. Default mode is read-only.
SLA_MCP_TRANSPORT=stdio
SLA_MCP_HOST=127.0.0.1
SLA_MCP_PORT=8001
SLA_MCP_LOG_LEVEL=WARNING
SLA_MCP_ALLOW_WRITES=false
SLA_MCP_ALLOW_RUNS=false

# Android/Appium connectivity
SLA_START_APPIUM=false
APPIUM_URL=http://host.docker.internal:4723
ANDROID_SDK_ROOT=
ANDROID_HOME=
ANDROID_ADB_PATH=
ANDROID_EMULATOR_PATH=
APPIUM_MAIN_SCRIPT=

# Manual cleanup defaults shown in Settings > 운영 데이터.
SLA_RETENTION_KEEP_LAST=100
SLA_RETENTION_DAYS=30
